# Environment Variables for Development
# Copy this file as .env and fill in the values

# ====================
# GraphQL API Configuration
# ====================
# Contact FarmRPG developers for API access
# This endpoint is required for recipe and item data updates
VITE_API_ENDPOINT=https://your-api-endpoint.com/graphql
GRAPHQL_API_ENDPOINT=https://your-api-endpoint.com/graphql

# ====================
# Telegram Bot Configuration
# ====================
# Used for bug report submissions
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# ====================
# Vercel Environment Variables
# ====================
# Add these variables in your Vercel project settings at vercel.com
NODE_ENV=production
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here
ALLOWED_ORIGINS=*
